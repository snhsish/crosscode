DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Gmail + Nodemailer Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=CrossCode

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Public site URL (used for sitemap.xml and robots.txt)
NEXT_PUBLIC_APP_URL=https://crosscode.site

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# DoDo Payments
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=live_mode
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_PRO_YEARLY=
DODO_PRODUCT_TEAM_MONTHLY=
DODO_PRODUCT_TEAM_YEARLY=
DODO_PRODUCT_FOUNDER_LIFETIME=
# Legacy (existing starter/builder subscriptions only, grandfathered to Pro):
# DODO_PRODUCT_STARTER_MONTHLY=
# DODO_PRODUCT_STARTER_YEARLY=
# DODO_PRODUCT_BUILDER_MONTHLY=
# DODO_PRODUCT_BUILDER_YEARLY=

# Abuse protection: Upstash Redis (per-IP sliding-window rate limits)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Abuse protection: Cloudflare Turnstile (bot check on OTP / waitlist / feedback forms)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Sentry error monitoring (optional, disabled when blank)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=crosscode-web
SENTRY_AUTH_TOKEN=

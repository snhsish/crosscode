{
  "name": "crosscode",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/snhsish/crosscode"
  },
  "bin": {
    "crosscode": "./dist/cli.js"
  },
  "version": "0.6.3",
  "description": "An OpenCode Remote Client CLI",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup src/cli.ts --out-dir dist --format esm --clean",
    "dev": "tsup src/cli.ts --out-dir dist --format esm --watch",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "opencode",
    "client",
    "remote"
  ],
  "author": "snhsish",
  "license": "MIT",
  "devDependencies": {
    "@crosscode/shared": "workspace:^",
    "@types/node": "^26.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.13",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "ora": "^9.4.1",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  }
}
